# ============================================
# WebGuard AI — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
# ============================================

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://backend01:Backend2026Pass123@backendclustor01.2pdjmbo.mongodb.net/?retryWrites=true&w=majority&appName=backendClustor01
MONGODB_DB_NAME=webguard

# ---------- Backend (Node.js/Express) ----------
NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# ---------- ML Service (Python/FastAPI) ----------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=WebGuard AI

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SCAN_RATE_LIMIT_WINDOW_MS=60000
SCAN_RATE_LIMIT_MAX_REQUESTS=10

# ---------- Security ----------
CORS_ORIGIN=http://localhost:3000
MAX_REQUEST_SIZE=1mb
REQUEST_TIMEOUT_MS=30000
WEBPAGE_FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_SIZE_BYTES=5242880
MAX_REDIRECTS=5

# ---------- Admin ----------
ADMIN_EMAIL=admin@webguard.ai
ADMIN_PASSWORD=admin123456
